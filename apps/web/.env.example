# URL pública de la API (NestJS en Coolify)
PUBLIC_API_URL=http://localhost:3000
# Clave pública de Cloudflare Turnstile (vacía en desarrollo)
PUBLIC_TURNSTILE_SITE_KEY=
# Dominio del sitio, para URLs canónicas y el sitemap
SITE_URL=https://ccvida.com.ar
# true = versión de muestra: formularios simulados, aviso arriba y sin indexar
PUBLIC_DEMO=false
