---
// Comprobante del voucher: se arma en cada consulta porque el estado cambia
// cuando tesorería confirma el pago.
import type { EstadoVoucher, VoucherPublico } from '@ccvida/shared';
import Base from '../../../layouts/Base.astro';
import { API_URL, DEMO } from '../../../lib/api';
import { numeroVoucher, usd } from '../../../lib/formato';

export const prerender = false;

const numero = Number(Astro.params.numero);
let voucher: VoucherPublico | null = null;
let problema: 'no-existe' | 'sin-conexion' | null = null;

if (!Number.isInteger(numero) || numero < 1) {
  problema = 'no-existe';
} else if (DEMO) {
  voucher = {
    numero,
    montoUsd: 50,
    estado: 'pendiente',
    formaPago: 'efectivo',
    creado: new Date().toISOString(),
    instrucciones: `Acercate a la mesa Pro Templo el domingo después de la reunión y decí tu número: Nº ${numeroVoucher(numero)}.`,
  };
} else {
  try {
    const res = await fetch(`${API_URL}/api/vouchers/${numero}`);
    if (res.ok) voucher = (await res.json()) as VoucherPublico;
    else problema = res.status === 404 ? 'no-existe' : 'sin-conexion';
  } catch {
    problema = 'sin-conexion';
  }
}

if (problema === 'no-existe') Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');

const estados: Record<EstadoVoucher, { titulo: string; texto: string; color: string }> = {
  pendiente: { titulo: 'Pendiente de pago', texto: 'Cuando tesorería reciba el pago, tu voucher suma a la pared.', color: 'bg-amarillo text-black' },
  confirmado: { titulo: 'Confirmado', texto: '¡Gracias! Tu voucher ya está en la pared de Pro Templo.', color: 'bg-verde-hoja text-black' },
  vencido: { titulo: 'Vencido', texto: 'Pasó el plazo sin que registráramos el pago. Si ya pagaste o querés pagarlo ahora, escribinos y lo reactivamos.', color: 'bg-texto text-black' },
  anulado: { titulo: 'Anulado', texto: 'Este voucher fue anulado. Si creés que es un error, escribinos.', color: 'bg-texto text-black' },
};
const estado = voucher ? estados[voucher.estado] : null;
---

<Base titulo={voucher ? `Voucher Nº ${numeroVoucher(voucher.numero)}` : 'Voucher'} descripcion="Estado de tu voucher Pro Templo." noindex>
  <section class="wrap flex max-w-[760px] flex-col gap-8 pt-14 pb-30">
    <a href="/pro-templo" class="self-start text-sm font-bold">← Pro Templo</a>
    {
      voucher && estado ? (
        <>
          <h1 class="d h2">
            Tu voucher <span class="text-amarillo">Nº {numeroVoucher(voucher.numero)}</span>
          </h1>
          <div class="relative flex items-center justify-between gap-4 overflow-hidden rounded-[18px] border border-linea bg-panel px-7 py-6">
            <span>
              <span class="block text-xs font-bold tracking-[.08em] text-verde-hoja">VOUCHER PRO TEMPLO</span>
              <span class="d block text-[clamp(42px,8vw,64px)] leading-none text-amarillo">USD {usd(voucher.montoUsd)}</span>
            </span>
            <span class:list={['chip px-3.5 py-2 text-sm', estado.color]}>{estado.titulo}</span>
          </div>
          <p class="lead m-0">{estado.texto}</p>
          {voucher.instrucciones && (
            <div class="flex flex-col gap-2 border-t border-linea pt-6">
              <h2 class="m-0 text-sm font-bold">Cómo pagarlo</h2>
              <p class="m-0 whitespace-pre-line">{voucher.instrucciones}</p>
            </div>
          )}
        </>
      ) : problema === 'no-existe' ? (
        <>
          <h1 class="d h2">No encontramos ese voucher</h1>
          <p class="lead muted m-0">Revisá el número en el email que te mandamos. Si el problema sigue, escribinos.</p>
        </>
      ) : (
        <>
          <h1 class="d h2">No pudimos consultar tu voucher</h1>
          <p class="lead muted m-0">Probá de nuevo en unos minutos. Tu voucher sigue registrado.</p>
        </>
      )
    }
  </section>
</Base>
