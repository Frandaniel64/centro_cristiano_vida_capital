---
import MinisterioArticulo from '../../components/MinisterioArticulo.astro';
import Base from '../../layouts/Base.astro';
import { fotos } from '../../data/estaticos';
import { contenido } from '../../lib/contenido';

export const prerender = false;

const { ministerios } = await contenido();
const nombres = ministerios.map((m) => m.nombre);
const descripcion = nombres.length
  ? `${nombres.join(', ')}: hay un lugar para cada etapa de la vida.`
  : 'Hay un lugar para cada etapa de la vida en CCVida Capital.';
---

<Base titulo="Ministerios" descripcion={descripcion} imagen={ministerios[0]?.foto ?? fotos.kidsVida}>
  <section class="wrap flex flex-col gap-8 pt-14 pb-18">
    <h1 class="d h1">Crecemos <span class="text-azul-link">juntos</span></h1>
    <p class="lead muted max-w-[560px] border-t border-linea pt-6">
      Hay un lugar para cada etapa de la vida. Encontrá el tuyo y sumate cuando quieras: no hace falta anotarse para venir la primera vez.
    </p>
  </section>
  {ministerios.map((m, i) => <MinisterioArticulo ministerio={m} invertido={i % 2 === 1} />)}
  {
    ministerios.length === 0 && (
      <section class="wrap flex flex-col items-start gap-5 pb-30">
        <p class="lead muted m-0">Pronto vas a encontrar acá todos nuestros ministerios. Mientras tanto, te esperamos el domingo.</p>
        <a href="/visitanos" class="btn b-verde">Planeá tu visita</a>
      </section>
    )
  }
</Base>
