---
import { fotos, nav, navCompleta } from '../data/estaticos';

const actual = Astro.url.pathname.replace(/\/$/, '') || '/';
const esActual = (href: string) => (href === '/' ? actual === '/' : actual.startsWith(href));
const acento = (href: string) =>
  esActual(href) ? 'text-verde-hoja' : href === '/pro-templo' ? 'text-amarillo' : 'text-texto';
---

<header class="border-b border-linea bg-fondo">
  <div class="wrap flex items-center justify-between gap-4 py-3.5">
    <a href="/" aria-label="CCVida Capital, ir al inicio" class="flex items-center gap-3 text-texto no-underline">
      <img src={fotos.logo.url} alt="" width="40" height="40" class="size-10 rounded-full object-cover" />
      <span class="d text-[19px] tracking-[-.01em]">CCVida Capital</span>
    </a>

    <nav aria-label="Principal" class="nav-links items-center gap-0.5">
      <span data-en-vivo hidden class="chip mr-2 bg-rojo-vivo text-white">
        <span class="size-2 rounded-full bg-white"></span>En vivo ahora
      </span>
      {
        nav.map((n) => (
          <a
            href={n.href}
            aria-current={esActual(n.href) ? 'page' : undefined}
            class:list={[
              'inline-flex min-h-11 items-center rounded-full px-3.5 text-sm font-semibold no-underline',
              esActual(n.href) ? 'bg-texto text-black' : 'text-texto',
            ]}
          >
            {n.label}
          </a>
        ))
      }
      <a href="/visitanos" class="btn b-verde ml-2 min-h-11 px-5 text-sm">Planeá tu visita</a>
    </nav>

    <button
      type="button"
      class="menu-btn size-11 cursor-pointer items-center justify-center rounded-full border border-borde-control bg-fondo"
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir menú"
      data-menu-btn
    >
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f5f5f0" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
    </button>
  </div>

  <nav id="menu-movil" aria-label="Menú" hidden class="flex flex-col border-t border-linea">
    {
      navCompleta.map((n) => (
        <a
          href={n.href}
          aria-current={esActual(n.href) ? 'page' : undefined}
          class:list={['d flex min-h-15 items-center border-b border-linea px-6 text-[28px] no-underline', acento(n.href)]}
        >
          {n.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  import { estaEnVivo } from '../lib/envivo';

  const boton = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.getElementById('menu-movil');
  boton?.addEventListener('click', () => {
    const abierto = boton.getAttribute('aria-expanded') === 'true';
    boton.setAttribute('aria-expanded', String(!abierto));
    boton.setAttribute('aria-label', abierto ? 'Abrir menú' : 'Cerrar menú');
    if (menu) menu.hidden = abierto;
  });

  const marcarEnVivo = () => {
    const vivo = estaEnVivo();
    document.querySelectorAll<HTMLElement>('[data-en-vivo]').forEach((el) => (el.hidden = !vivo));
  };
  marcarEnVivo();
  setInterval(marcarEnVivo, 60_000);
</script>
