---
import type { PredicaPublica } from '@ccvida/shared';
import { fechaLarga } from '../lib/formato';
import Foto from './Foto.astro';

interface Props {
  predica: PredicaPublica;
}
const { predica: p } = Astro.props;
---

<article class="relative flex flex-col gap-4" data-serie={p.serie ?? ''}>
  <div class="relative aspect-[16/10] overflow-hidden rounded-[20px] bg-panel">
    {p.foto && <Foto foto={p.foto} decorativa sizes="(max-width: 860px) 100vw, 33vw" class="absolute inset-0" />}
    {p.duracionMin && <span class="chip absolute right-3.5 bottom-3.5 bg-black text-texto">{p.duracionMin} min</span>}
  </div>
  <div class="flex flex-col gap-1.5">
    {p.serie && <p class="m-0 text-sm font-bold text-verde-hoja">{p.serie}</p>}
    <h3 class="d text-[28px] leading-[1.1] tracking-[-.02em]">
      <a href={`/predicas/${p.slug}`} class="text-texto no-underline after:absolute after:inset-0 hover:underline">{p.titulo}</a>
    </h3>
    {p.resumen && <p class="muted m-0">{p.resumen}</p>}
    <p class="muted mt-1 mb-0 text-sm">{fechaLarga(p.fecha)} · {p.predicador}</p>
  </div>
</article>
