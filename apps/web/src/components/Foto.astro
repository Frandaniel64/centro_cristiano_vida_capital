---
import { srcset, type Foto } from '../lib/fotos';

interface Props {
  foto: Foto;
  // Ancho que ocupa en pantalla, para que el navegador elija el tamaño justo.
  sizes: string;
  // Solo las fotos del primer pantallazo cargan de inmediato.
  prioridad?: boolean;
  // Para fotos decorativas dentro de un link que ya tiene texto.
  decorativa?: boolean;
  class?: string;
}

const { foto, sizes, prioridad = false, decorativa = false, class: clase } = Astro.props;
---

<img
  src={foto.url}
  srcset={srcset(foto)}
  sizes={sizes}
  alt={decorativa ? '' : foto.alt}
  loading={prioridad ? 'eager' : 'lazy'}
  fetchpriority={prioridad ? 'high' : 'auto'}
  decoding="async"
  class:list={['foto', clase]}
/>
