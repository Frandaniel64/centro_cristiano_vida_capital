---
import { config, navCompleta } from '../data/sitio';
---

<footer class="overflow-hidden border-t border-linea px-6 pt-16 pb-6">
  <div class="mx-auto flex max-w-[1360px] flex-col gap-10">
    <div class="flex flex-wrap justify-between gap-8">
      <p class="d flex-[1_1_280px] text-[32px] leading-[1.1]">¡La iglesia sos <span class="text-verde-hoja">vos</span>!</p>
      <div class="flex-[0_1_220px] text-[15px]">
        <p class="m-0 font-bold">Reunión</p>
        <p class="muted mt-1 mb-0">{config.reunion}<br />{config.direccion}, {config.barrio}</p>
      </div>
      <nav aria-label="Pie" class="flex flex-[0_1_200px] flex-col items-start gap-0.5 text-[15px]">
        <p class="m-0 mb-1 font-bold">Secciones</p>
        {navCompleta.map((n) => <a href={n.href} class="inline-flex min-h-8 items-center no-underline">{n.label}</a>)}
      </nav>
      <div class="flex flex-[0_1_200px] flex-col gap-1 text-[15px]">
        <p class="m-0 font-bold">Seguinos</p>
        <a href={config.instagram.url}>Instagram {config.instagram.usuario}</a>
        {config.youtube.url && <a href={config.youtube.url}>YouTube</a>}
        <a href={`https://wa.me/${config.whatsapp.numero}`}>WhatsApp {config.whatsapp.visible}</a>
      </div>
    </div>
    <p class="d m-0 self-start text-[40px] leading-none tracking-[-.02em] text-texto [-webkit-text-stroke:2px_#3a3a3a]">
      CC<span class="text-verde-hoja">Vida</span>
    </p>
    <p class="muted m-0 flex flex-wrap gap-x-4 border-t border-linea pt-4 text-[13px]">
      <span>© {new Date().getFullYear()} {config.nombre}</span>
      <a href="/privacidad" class="text-texto-suave">Política de privacidad</a>
    </p>
  </div>
</footer>
