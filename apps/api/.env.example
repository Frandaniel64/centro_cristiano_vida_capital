PORT=3000

# Postgres en Coolify
DATABASE_URL=postgresql://ccvida:ccvida@localhost:5434/ccvida

# Dirección pública del sitio, para los links de los emails
SITE_URL=http://localhost:4321

# Orígenes permitidos (sitio y panel)
CORS_ORIGINS=http://localhost:4321,http://localhost:4200

# Resend. Sin clave, los emails solo se escriben en el log.
RESEND_API_KEY=
EMAIL_FROM=CCVida Capital <hola@ccvida.com.ar>
# Avisos internos: visita nueva a recepción, voucher nuevo a tesorería. Vacío = sin aviso.
RECEPCION_EMAIL=
TESORERIA_EMAIL=

# Cookie de sesión del panel. Si el panel y la API están en subdominios del mismo
# dominio (admin.ccvida.com.ar y api.ccvida.com.ar): lax y COOKIE_DOMAIN=.ccvida.com.ar.
# Si están en dominios distintos (demo en workers.dev): COOKIE_SAMESITE=none.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# true en producción (solo HTTPS). Por defecto se activa con NODE_ENV=production.
COOKIE_SECURE=

# Cloudflare Turnstile. Sin clave secreta no se verifica.
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (compatible con S3), para el panel
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ccvida-medios
R2_PUBLIC_URL=

# Dirección pública de la API (para las URLs de fotos guardadas en disco, sin R2)
API_URL=http://localhost:3000
