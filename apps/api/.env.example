PORT=3000

# Postgres en Coolify
DATABASE_URL=postgresql://ccvida:ccvida@localhost:5434/ccvida

# Dirección pública del sitio, para los links de los emails
SITE_URL=http://localhost:4321

# Orígenes permitidos (sitio y panel)
CORS_ORIGINS=http://localhost:4321,http://localhost:4200

# Resend. Sin clave, los emails solo se escriben en el log.
RESEND_API_KEY=
EMAIL_FROM=CCVida Capital <hola@ccvida.com.ar>
# Avisos internos: visita nueva a recepción, voucher nuevo a tesorería. Vacío = sin aviso.
RECEPCION_EMAIL=
TESORERIA_EMAIL=

# Cloudflare Turnstile. Sin clave secreta no se verifica.
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (compatible con S3), para el panel
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ccvida-medios
R2_PUBLIC_URL=
